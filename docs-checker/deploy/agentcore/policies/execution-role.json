{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeDocsCheckerProfilesOnly",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "@HAIKU_PROFILE_ARN@",
        "@SONNET_PROFILE_ARN@",
        "arn:aws:bedrock:us-west-2:414696729697:inference-profile/global.anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:us-west-2:414696729697:inference-profile/global.anthropic.claude-sonnet-5-5",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-5-5",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-sonnet-5-5"
      ]
    },
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPull",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:us-west-2:414696729697:repository/docs-checker"
    },
    {
      "Sid": "RuntimeLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"],
      "Resource": [
        "arn:aws:logs:us-west-2:414696729697:log-group:/aws/bedrock-agentcore/runtimes/*",
        "arn:aws:logs:us-west-2:414696729697:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"
      ]
    },
    {
      "Sid": "LogGroupDiscovery",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:us-west-2:414696729697:log-group:*"
    },
    {
      "Sid": "FindingsLog",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-west-2:414696729697:log-group:/docs-checker/findings",
        "arn:aws:logs:us-west-2:414696729697:log-group:/docs-checker/findings:log-stream:*"
      ]
    },
    {
      "Sid": "WorkloadIdentity",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetWorkloadAccessToken",
        "bedrock-agentcore:GetWorkloadAccessTokenForJWT",
        "bedrock-agentcore:GetWorkloadAccessTokenForUserId"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-west-2:414696729697:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:us-west-2:414696729697:workload-identity-directory/default/workload-identity/*"
      ]
    }
  ]
}
