# Non-secret env for runtime docs_checker_bedrock. 03-runtime.sh adds
# DOCS_CHECKER_BEDROCK_MODEL_IDS, DOCS_CHECKER_MCP_URL and AWS_REGION.
DOCS_CHECKER_RUNTIME=agentcore
DOCS_CHECKER_MODEL_PROVIDER=bedrock
DOCS_CHECKER_RATE_CARD=bedrock-global-2026-10-19
# docs/agentcore-probes.md: the Haiku profile accepts output_config.effort.
DOCS_CHECKER_BEDROCK_EFFORT=true
DOCS_CHECKER_REPO=chghealthcare/chg-infra-opentofu-bedrock
DOCS_CHECKER_PROFILE=/app/profiles/chg-infra-opentofu-bedrock.yaml
# AgentCore's request timeout is 15 minutes and not adjustable.
DOCS_CHECKER_RUN_TIMEOUT_S=780
DOCS_CHECKER_FINDINGS_LOG_GROUP=/docs-checker/findings
DOCS_CHECKER_SEARCH=false
# docs/agentcore-probes.md: prompt caching writes and reads on Bedrock, so every lever is on.
DOCS_CHECKER_LEVERS=all
