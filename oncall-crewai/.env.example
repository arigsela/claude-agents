# OnCall CrewAI Multi-Agent System - Environment Variables

# Anthropic API Key (required for all agents)
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic Model (CrewAI native Anthropic provider)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Agent Service URLs (orchestrator uses these to discover A2A agents)
K8S_AGENT_URL=http://k8s-agent-a2a:8080
GITHUB_AGENT_URL=http://github-agent-a2a:8080

# API Server Configuration (orchestrator)
API_HOST=0.0.0.0
API_PORT=8000

# API Authentication (comma-separated list of valid API keys)
API_KEYS=your-api-key-1,your-api-key-2

# CORS Configuration
CORS_ORIGINS=*

# Agent Log Level (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO

# GitHub Configuration (github-agent only)
GITHUB_TOKEN=your-github-token-here
GITHUB_ORG=arigsela
GITOPS_REPO=arigsela/kubernetes
GITOPS_BASE_PATH=base-apps/
GITOPS_BASE_BRANCH=main
DOCS_REPO=arigsela/claude-agents
