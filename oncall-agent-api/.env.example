# On-Call Troubleshooting Agent - Environment Variables

# Anthropic API Key
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic Model Selection
# Available models: claude-sonnet-4-5-20250929, claude-opus-4-5-20251101, claude-3-5-haiku-20241022
# See: https://docs.anthropic.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Incident Triage Severity Thresholds
# These control when incidents are escalated to different severity levels
# Adjust based on your operational requirements
TRIAGE_CRITICAL_OOM_RESTARTS=10        # OOMKilled restarts to trigger critical severity
TRIAGE_CRITICAL_SERVICE_RESTARTS=5     # Critical service restarts to trigger critical severity
TRIAGE_HIGH_RESTARTS=3                 # Restarts to trigger high severity
TRIAGE_MEDIUM_RESTARTS=1               # Restarts to trigger medium severity
TRIAGE_HUMAN_INTERVENTION_RESTARTS=15  # Restarts requiring human intervention
TRIAGE_ROLLBACK_CONFIDENCE=0.8         # Confidence threshold for rollback decisions (0.0-1.0)

# GitHub Configuration
GITHUB_TOKEN=your-github-token-here
GITHUB_ORG=artemishealth

# GitOps PR Creation
# The agent can create PRs in the GitOps repo for ArgoCD to sync
# GITHUB_TOKEN needs Contents (read/write) + Pull Requests (read/write) on this repo
GITOPS_REPO=arigsela/kubernetes
GITOPS_BASE_PATH=base-apps/
GITOPS_BASE_BRANCH=main

# Kubernetes Configuration
# Note: KUBECONFIG is automatically set by environment, or use default ~/.kube/config
KUBECONFIG=${HOME}/.kube/config
K8S_CONTEXT=dev-eks

# Zeus Memory Configuration (for agent memory persistence)
MEMORY_NAMESPACE=zeus

# AWS Credentials (for EKS authentication and resource verification)
# Required for Docker containers to access EKS clusters
# Also used by AWSIntegrator for Secrets Manager and ECR verification
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Agent Configuration
AGENT_LOG_LEVEL=INFO
AGENT_MAX_THINKING_TOKENS=12000

# Safety Configuration
ALLOWED_CLUSTERS=dev-eks
PROTECTED_CLUSTERS=prod-eks

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# API Authentication (comma-separated list of valid API keys)
# Leave empty for development mode (no authentication)
API_KEYS=your-api-key-1,your-api-key-2

# Session Management
SESSION_TTL_MINUTES=30
MAX_SESSIONS_PER_USER=5

# Rate Limiting
RATE_LIMIT_AUTHENTICATED=60      # Requests per minute for authenticated users
RATE_LIMIT_UNAUTHENTICATED=10    # Requests per minute for unauthenticated users

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=*  # Use specific origins in production (e.g., http://localhost:5678,https://n8n.example.com)

# Datadog Integration (for Kubernetes metrics and historical analysis)
# Get API and App keys from: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=your-datadog-api-key-here
DATADOG_APP_KEY=your-datadog-app-key-here
DATADOG_SITE=datadoghq.com  # Use datadoghq.eu for EU region

# Zeus API Integration (for refresh job status and events)
# Zeus is accessed via internal Kubernetes service DNS
# Available namespaces: preprod, qa, devmatt, devjeff, merlinqa, etc.
ZEUS_NAMESPACE=preprod
ZEUS_SERVICE=zeus-service
ZEUS_PORT=9000
ZEUS_INTEGRATION_ENABLED=true

# Zeus HTTP Basic Authentication
# Required for API access - Zeus uses Play Framework Basic Auth
# Get credentials from your team or Kubernetes secrets
ZEUS_WEB_BASIC_AUTH_USERNAME=your-zeus-username
ZEUS_WEB_BASIC_AUTH_PASSWORD=your-zeus-password

# AWS Cost Explorer Integration (for cost anomaly detection and analysis)
# Requires IAM permissions: ce:GetAnomalies, ce:GetCostAndUsage, ce:GetCostForecast
# AWS Cost Anomaly Detection must be enabled in your AWS account
# Note: Uses same AWS credentials as above (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
AWS_COST_EXPLORER_ENABLED=true

# AWS Athena CUR Integration (for detailed cost analysis via CUR data)
# Requires IAM permissions: athena:*, s3:*, glue:GetTable, glue:GetDatabase
# CUR (Cost and Usage Report) must be configured and delivering to S3
# See: https://docs.aws.amazon.com/cur/latest/userguide/cur-create.html
ATHENA_DATABASE=athenacurcfn_c_u_r_athena
ATHENA_TABLE=cost_and_usage_report
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_BUCKET=s3://aws-athena-query-results-ACCOUNTID-REGION/
ATHENA_REGION=us-east-1

# Web Search (Tavily) — Required for AI Desk Assistant web search
# Get API key from: https://app.tavily.com/
TAVILY_API_KEY=tvly-your-key-here

# Microsoft Teams Integration
# Two authentication methods supported:

# Option 1: Native Outgoing Webhook (HMAC authentication)
# To enable:
# 1. Create an Outgoing Webhook in your Teams team settings
# 2. Set the callback URL to: https://your-server.com/teams/webhook
# 3. Copy the security token provided by Teams
# Get the secret from: Teams → Manage Team → Apps → Create Outgoing Webhook
TEAMS_WEBHOOK_SECRET=your-base64-secret-from-teams

# Option 2: Power Automate (API key authentication)
# Use this if Outgoing Webhooks are disabled in your organization
# To enable:
# 1. Generate a strong random API key (e.g., openssl rand -base64 32)
# 2. Set it here and in your Power Automate flow HTTP action header
# The flow should send: X-API-Key: {your-key} or Authorization: Bearer {your-key}
TEAMS_API_KEY=your-api-key-for-power-automate